<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>v12</title>

<link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
<script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

<style>
body{
margin:0;
font-family:Segoe UI,sans-serif;
background:#eef3f8;
font-size:13px;
}

.wrap{
max-width:1000px;
margin:auto;
padding:10px;
}

#a4{
width:185mm;
background:white;
margin:auto;
padding:6mm;
box-sizing:border-box;
}

.print-header{
background:#0088cc;
color:white;
padding:7px;
text-align:center;
font-size:18px;
font-weight:700;
margin-bottom:8px;
border-radius:6px;
}

.card{
border:1px solid #d8d8d8;
border-radius:8px;
padding:8px;
margin-bottom:8px;
background:white;
}

.grid{
display:grid;
grid-template-columns:90px 1fr 110px 120px 60px;
gap:8px;
align-items:end;
}

.grid-proyecto{
display:grid;
grid-template-columns:90px 110px 1fr 110px 120px 60px;
gap:8px;
align-items:end;
}

.field{
display:flex;
flex-direction:column;
}

label{
font-size:11px;
font-weight:700;
margin-bottom:3px;
color:#444;
}

input,select{
padding:7px;
border:1px solid #cfcfcf;
border-radius:6px;
font-size:12px;
box-sizing:border-box;
width:100%;
}

#horas{
width:60px;
}

.section-title{
font-size:12px;
font-weight:700;
margin-bottom:5px;
color:#0088cc;
}

.ql-toolbar{
padding:4px!important;
}

.ql-editor{
min-height:90px;
font-size:12px;
padding:8px!important;
overflow:visible!important;
}

.buttons{
display:flex;
gap:10px;
flex-wrap:wrap;
margin-top:12px;
}

button{
background:#0088cc;
color:white;
border:none;
padding:9px 14px;
border-radius:8px;
font-size:12px;
font-weight:700;
cursor:pointer;
}

.hidden{
display:none;
}

@media(max-width:900px){
.grid,.grid-proyecto{
grid-template-columns:1fr 1fr;
}
#a4{
width:100%;
}
#horas{
width:100%;
}
}

@media(max-width:600px){
.grid,.grid-proyecto{
grid-template-columns:1fr;
}
}
</style>
</head>

<body>

<div class="wrap">

<div id="a4">

<div class="print-header" id="tituloParte">
PARTE DIARIO GGRR
</div>

<div class="card">

<div id="contenedorGrid" class="grid">

<div class="field">
<label>Tipo</label>
<select id="tipo" onchange="actualizarVista()">
<option>GGRR</option>
<option>Proyecto</option>
</select>
</div>

<div class="field hidden" id="proyectoBox">
<label>Proyecto</label>
<input id="numProyecto">
</div>

<div class="field">
<label>Responsable</label>
<input id="responsable" placeholder="Nombre y dos apellidos">
</div>

<div class="field">
<label>Fecha</label>
<input id="fecha">
</div>

<div class="field">
<label>Turno</label>
<select id="turno">
<option>Mañana</option>
<option>Tarde</option>
<option>Noche</option>
<option>Sol</option>
<option>Luna</option>
</select>
</div>

<div class="field">
<label>Horas</label>
<input type="number" id="horas">
</div>

</div>

</div>

<div class="card">
<div class="section-title">Trabajos realizados</div>
<div id="editor1"></div>
</div>

<div class="card">
<div class="section-title">Incidencias</div>
<div id="editor2"></div>
</div>

<div class="card">
<div class="section-title">Observaciones</div>
<div id="editor3"></div>
</div>

</div>

<div class="buttons">
<button onclick="guardar()">Guardar</button>
<button onclick="exportarPDF()">PDF</button>
<button onclick="guardarDOC()">DOC</button>
<button onclick="outlook()">Outlook</button>
</div>

</div>

<script>

const toolbar = [
['bold','italic','underline'],
[{color:[]}],
[{list:'bullet'}]
];

const q1 = new Quill('#editor1',{theme:'snow',modules:{toolbar}});
const q2 = new Quill('#editor2',{theme:'snow',modules:{toolbar}});
const q3 = new Quill('#editor3',{theme:'snow',modules:{toolbar}});

fecha.value = new Date().toLocaleDateString('es-ES',{
day:'2-digit',
month:'2-digit',
year:'2-digit'
});

function actualizarVista(){

document.getElementById('tituloParte').innerText =
'PARTE DIARIO ' + tipo.value.toUpperCase();

const proyecto = tipo.value === 'Proyecto';

document.getElementById('proyectoBox').classList.toggle('hidden', !proyecto);

document.getElementById('contenedorGrid').className =
proyecto ? 'grid-proyecto' : 'grid';

}

actualizarVista();

function nombreArchivo(){

const f = new Date().toISOString().split('T')[0];

return `Parte_${tipo.value}_${f}`;

}

function guardar(){

const datos = {
tipo:tipo.value,
proyecto:numProyecto.value,
responsable:responsable.value,
fecha:fecha.value,
turno:turno.value,
horas:horas.value,
trabajos:q1.root.innerHTML,
incidencias:q2.root.innerHTML,
observaciones:q3.root.innerHTML
};

localStorage.setItem('parte_v12',JSON.stringify(datos));

alert('Guardado correctamente');

}

window.onload = ()=>{

const d = JSON.parse(localStorage.getItem('parte_v12'));

if(d){

tipo.value=d.tipo;
numProyecto.value=d.proyecto;
responsable.value=d.responsable;
fecha.value=d.fecha;
turno.value=d.turno;
horas.value=d.horas;

q1.root.innerHTML=d.trabajos;
q2.root.innerHTML=d.incidencias;
q3.root.innerHTML=d.observaciones;

actualizarVista();

}

};

async function exportarPDF(){

await html2pdf().set({
margin:[2,2,2,2],
filename:nombreArchivo()+'.pdf',
image:{type:'jpeg',quality:1},
html2canvas:{scale:2,scrollY:0},
jsPDF:{unit:'mm',format:'a4',orientation:'portrait'}
}).from(document.getElementById('a4')).save();

}

function guardarDOC(){

const contenido = `
PARTE DIARIO ${tipo.value}

Responsable: ${responsable.value}
Fecha: ${fecha.value}

TRABAJOS
${q1.getText()}

INCIDENCIAS
${q2.getText()}

OBSERVACIONES
${q3.getText()}
`;

const blob = new Blob([contenido],{type:'application/msword'});

const a = document.createElement('a');
a.href = URL.createObjectURL(blob);
a.download = nombreArchivo()+'.doc';
a.click();

}

function outlook(){

const body = `
Responsable: ${responsable.value}

TRABAJOS:
${q1.getText()}

INCIDENCIAS:
${q2.getText()}

OBSERVACIONES:
${q3.getText()}
`;

window.location.href =
`mailto:?subject=${encodeURIComponent(nombreArchivo())}&body=${encodeURIComponent(body)}`;

}

</script>

</body>
</html>
